Screen { background: $lc-black; color: $lc-peach; }

#header { height: 3; }
#title { width: 1fr; height: 3; background: $lc-orange; color: $lc-black; text-style: bold; padding: 0 2; border: round $lc-orange; }
#cap { width: 8; height: 3; background: $lc-lavender; border: round $lc-lavender; }
#clock { width: 28; height: 3; background: $lc-periwinkle; color: $lc-black; padding: 0 2; text-align: right; text-style: bold; border: round $lc-periwinkle; }

#body { height: 1fr; }
#sidebar { width: 24; }
.block { height: 2; color: $lc-black; text-style: bold; padding: 0 1; margin-bottom: 1; }
.block:hover { text-style: bold reverse; }
#n-status { background: $lc-orange; }
#n-homedev { background: $lc-peach; }
#n-terminal { background: $lc-periwinkle; }
#n-mindchuk { background: $lc-peach; }
#n-sessions { background: $lc-lavender; }
#n-usage { background: $lc-blue; }
#n-monitor { background: $lc-periwinkle; }
#n-theme { background: $lc-periwinkle; }
#n-help { background: $lc-blue; margin-bottom: 0; }
#spacer { height: 1fr; background: $lc-lavender; margin-bottom: 1; }

#views { width: 1fr; padding: 0 1; }
StatusView, TerminalView, MindchukView, SessionsView, UsageView { height: 1fr; }

#list-title, #detail-title, .view-title { color: $lc-orange; text-style: bold; height: 1; margin-top: 1; }
.view-status { height: 1; color: $lc-blue; }
#table { height: 1fr; min-height: 8; background: $lc-black; border: round $lc-periwinkle; }
#table:focus { border: round $lc-orange; }
.lt-table { height: 1fr; min-height: 6; background: $lc-black; border: round $lc-periwinkle; }
.lt-table:focus { border: round $lc-orange; }
DataTable { background: $lc-black; color: $lc-peach; }
DataTable > .datatable--header { background: $lc-periwinkle; color: $lc-black; text-style: bold; }
DataTable > .datatable--cursor { background: $lc-orange; color: $lc-black; text-style: bold; }
DataTable > .datatable--hover { background: $lc-lavender; color: $lc-black; }
DataTable:focus > .datatable--cursor { background: $lc-orange; color: $lc-black; }
#detail { height: 2fr; border: round $lc-lavender; padding: 0 1; }
#detail:focus { border: round $lc-orange; }
.lt-text { height: 2fr; border: round $lc-lavender; padding: 0 1; }
.lt-text:focus { border: round $lc-orange; }
.panel-title { background: $lc-lavender; color: $lc-black; text-style: bold; padding: 0 1; margin-top: 1; }
.panel-body { padding: 0 1; }
#statusbar { height: 1; background: $lc-blue; color: $lc-black; padding: 0 1; }
Footer { background: $lc-red; color: $lc-black; }
Footer FooterKey { background: $lc-red; color: $lc-black; }
Footer FooterKey .footer-key--key { background: $lc-peach; color: $lc-black; text-style: bold; }
Footer FooterKey .footer-key--description { color: $lc-black; background: $lc-red; }

#term-out { height: 1fr; border: round $lc-orange; background: $lc-black; color: $lc-peach; scrollbar-background: $lc-black; }
#term-row { height: 3; margin-top: 1; }
#term-prompt { width: auto; min-width: 6; height: 3; background: $lc-orange; color: $lc-black; text-style: bold; padding: 1 1; }
#term-in { width: 1fr; background: $lc-black; color: $lc-peach; border: round $lc-lavender; }
#term-in:focus { border: round $lc-orange; }

Input { background: $lc-black; color: $lc-peach; border: round $lc-lavender; }
Input:focus { border: round $lc-orange; }
TextArea { background: $lc-black; color: $lc-peach; border: round $lc-lavender; }
TextArea:focus { border: round $lc-orange; }

BranchPicker, ConfirmScreen, EntryEditor, HelpScreen { align: center middle; background: $lc-black 60%; }
.dialog { background: $lc-black; border: round $lc-orange; }
.dialog-title { background: $lc-orange; color: $lc-black; text-style: bold; padding: 0 1; }
.dialog-hint { color: $lc-blue; padding: 0 1; }
.dialog-body { padding: 1 2; }
#picker { width: 60; height: 24; }
#picker OptionList { height: 1fr; background: $lc-black; border: none; }
#picker OptionList > .option-list--option-highlighted { background: $lc-orange; color: $lc-black; text-style: bold; }
#confirm { width: 60; height: auto; }
#editor { width: 90%; height: 90%; }
#editor TextArea { height: 1fr; }
#ed-msg { color: $lc-red; padding: 0 1; height: 1; }
#help { width: 90%; height: 90%; }
#help-scroll { height: 1fr; padding: 0 1; }
